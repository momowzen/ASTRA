# Google Sheets
# Spreadsheet ID (the part between /d/ and /edit in the sheet URL)
GOOGLE_SHEETS_ID=1-HG1_avrgEG6jpdFYwmQq6EDuBBQXKub9bo7IUxueCw

# Service account with Editor access on the spreadsheet above.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Keep the \n escapes exactly as shown, or paste the key as a single line.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,https://momowzen.github.io

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-24-characters
TOKEN_TTL=7d

# Sheet the app uses for login credentials (created automatically, kept hidden).
CREDENTIALS_TAB=credentials

# Sync: how often the server re-reads the sheet to pick up external edits.
SYNC_POLL_INTERVAL_MS=5000
SYNC_MAX_ROWS=2000
