{
  "name": "astra-guild-server",
  "version": "1.0.0",
  "private": true,
  "description": "Google Sheets-backed API for the ASTRA guild manager",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
